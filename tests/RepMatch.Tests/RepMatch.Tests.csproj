<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="2.3.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Respuestas reales de tiendas VTEX, grabadas para probar el adapter sin red. -->
  <ItemGroup>
    <None Include="..\fixtures\vtex\*.json" Link="fixtures\vtex\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RepMatch.Domain\RepMatch.Domain.csproj" />
    <ProjectReference Include="..\..\src\RepMatch.Common\RepMatch.Common.csproj" />
    <ProjectReference Include="..\..\src\RepMatch.Contracts\RepMatch.Contracts.csproj" />
    <ProjectReference Include="..\..\src\RepMatch.Persistence\RepMatch.Persistence.csproj" />
    <ProjectReference Include="..\..\src\RepMatch.Catalogo.Api\RepMatch.Catalogo.Api.csproj" />
    <ProjectReference Include="..\..\src\RepMatch.Aplicacion\RepMatch.Aplicacion.csproj" />
    <ProjectReference Include="..\..\src\RepMatch.Clientes.Rest\RepMatch.Clientes.Rest.csproj" />
    <ProjectReference Include="..\..\src\RepMatch.Clientes.Soap\RepMatch.Clientes.Soap.csproj" />
    <!-- Mismo motivo que Web: Catalogo.Soap tambien expone su propia clase Program. -->
    <ProjectReference Include="..\..\src\RepMatch.Catalogo.Soap\RepMatch.Catalogo.Soap.csproj" Aliases="Soap" />
    <!-- Con alias: Web y Catalogo.Api generan cada uno su clase Program publica, y sin esto
         WebApplicationFactory<Program> de las pruebas de integracion seria ambiguo. -->
    <ProjectReference Include="..\..\src\RepMatch.Web\RepMatch.Web.csproj" Aliases="Web" />
    <ProjectReference Include="..\..\src\RepMatch.IA\RepMatch.IA.csproj" />
    <ProjectReference Include="..\..\src\RepMatch.Fuentes.Vtex\RepMatch.Fuentes.Vtex.csproj" />
    <ProjectReference Include="..\..\src\RepMatch.Mensajeria\RepMatch.Mensajeria.csproj" />
    <!-- Mismo motivo que Web: el worker tambien expone su propia clase Program. -->
    <ProjectReference Include="..\..\src\RepMatch.Notificaciones.Worker\RepMatch.Notificaciones.Worker.csproj" Aliases="Worker" />
    <!-- Mismo motivo que Web: IA.Api tambien expone su propia clase Program. -->
    <ProjectReference Include="..\..\src\RepMatch.IA.Api\RepMatch.IA.Api.csproj" Aliases="IAApi" />
  </ItemGroup>

</Project>