@page "/clientes"
@implements IDisposable
@using RepMatch.Aplicacion.Fachada
@inject FachadaAplicacion Fachada
@inject SesionActual Sesion

<PageTitle>Mi garage — RepMatch</PageTitle>

@if (Sesion.Cliente is null)
{
    <section class="entrada">
        <h1>Tu garage</h1>
        <p>Ingresá para ver y administrar tus autos.</p>
    </section>
    <p><a class="boton" href="/login">Ingresar</a></p>
}
else
{
    <section class="entrada">
        <h1>Tu garage</h1>
        <p>Los autos con los que buscás piezas. Solo vos los ves.</p>
    </section>

    <div class="tarjeta">
        <h2 style="margin-top:0">Agregar vehículo</h2>

        <div class="formulario-garage">
            <SelectorVehiculo @key="selectorVersion" @bind-Valor="vehiculoNuevo" Prefijo="garage" Deshabilitado="@guardando" />
            <div class="campo campo-apodo">
                <label for="valias">Apodo (opcional)</label>
                <input id="valias" @bind="alias" @bind:event="oninput" maxlength="120" placeholder="El Gol de la facu" />
            </div>
        </div>

        <div class="acciones-formulario">
            <button @onclick="AgregarAsync" disabled="@guardando">
                @(guardando ? "Guardando…" : "Agregar vehículo")
            </button>
        </div>

        @if (errores.Count > 0)
        {
            <div class="alerta alerta-error" role="alert" aria-live="polite" style="margin-top:0.75rem">
                @foreach (var error in errores)
                {
                    <div>@error</div>
                }
            </div>
        }

        @if (mensaje is not null)
        {
            <div class="alerta alerta-exito" role="status" aria-live="polite" style="margin-top:0.75rem">
                @mensaje
            </div>
        }
    </div>

    <h2>Tus vehículos</h2>
    <div class="tarjeta">
        @if (Sesion.Cliente.Vehiculos.Count == 0)
        {
            <p class="vacio">Todavía no cargaste ningún vehículo. Agregá uno arriba para empezar a buscar piezas.</p>
        }
        else
        {
            <div style="display:grid; gap:0.55rem">
                @foreach (var vehiculo in Sesion.Cliente.Vehiculos)
                {
                    <div class="vehiculo-card">
                        <div class="vehiculo-info">
                            <strong>
                                @vehiculo.Alias
                                @if (vehiculo.Id == Sesion.Cliente.VehiculoPredeterminadoId)
                                {
                                    <span class="etiqueta etiqueta-predeterminado">Predeterminado</span>
                                }
                            </strong>
                            <span>@vehiculo.Datos</span>
                        </div>
                        <div class="vehiculo-acciones">
                            <a class="boton" href="/?v=@vehiculo.Id">Buscar piezas</a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private VehiculoDto? vehiculoNuevo;
    private string alias = "";
    private int selectorVersion;

    private bool guardando;
    private List<string> errores = [];
    private string? mensaje;

    protected override void OnInitialized() => Sesion.Cambio += AlCambiarSesion;

    private void AlCambiarSesion() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Sesion.Cambio -= AlCambiarSesion;

    private async Task AgregarAsync()
    {
        if (Sesion.Cliente is null)
            return;

        guardando = true;
        errores = [];
        mensaje = null;
        if (vehiculoNuevo is null)
        {
            errores = ["Elegí marca, modelo, año y motor del vehículo."];
            guardando = false;
            return;
        }

        try
        {
            var resultado = await Fachada.AgregarVehiculoAsync(
                Sesion.Cliente.Id, vehiculoNuevo, alias: string.IsNullOrWhiteSpace(alias) ? null : alias);

            if (resultado.EsFallido)
            {
                errores = [.. resultado.Errores];
                return;
            }

            await Sesion.EntrarAsync(resultado.Valor);
            var nombre = string.IsNullOrWhiteSpace(alias) ? vehiculoNuevo.ToString() : alias;
            mensaje = $"¡Listo! {nombre} quedó en tu garage.";
            vehiculoNuevo = null;
            selectorVersion++;
            alias = "";
        }
        finally
        {
            guardando = false;
        }
    }
}
