@page "/"
@implements IDisposable
@using RepMatch.Aplicacion.Fachada
@inject FachadaAplicacion Fachada
@inject SesionActual Sesion

<PageTitle>RepMatch</PageTitle>

@if (Sesion.Cliente is null)
{
    <section class="entrada">
        <h1>Buscá la pieza para tu auto</h1>
        <p>Ingresá tu vehículo y el problema. Te mostramos las piezas que le van.</p>
    </section>

    <div class="buscador">
        <div class="campos">
            <div>
                <label for="marca">Marca</label>
                <input id="marca" @bind="marcaAnon" placeholder="Volkswagen" />
            </div>
            <div>
                <label for="modelo">Modelo</label>
                <input id="modelo" @bind="modeloAnon" placeholder="Gol" />
            </div>
            <div>
                <label for="anio">Año</label>
                <input id="anio" type="number" @bind="anioAnon" placeholder="2015" />
            </div>
            <div>
                <label for="motor">Motor (opcional)</label>
                <input id="motor" @bind="motorAnon" placeholder="1.6" />
            </div>
        </div>

        <div style="margin-top:0.85rem">
            <label for="textoAnon">Qué le pasa</label>
            <textarea id="textoAnon" rows="3" @bind="textoAnon"
                      placeholder="Cuando freno vibra el volante y se escucha un chillido"></textarea>
        </div>

        @if (erroresAnon.Count > 0)
        {
            <div class="aviso error" style="margin-top:1rem">
                @foreach (var error in erroresAnon)
                {
                    <div>@error</div>
                }
            </div>
        }

        <p style="margin:1rem 0 0">
            <button @onclick="BuscarAnonAsync" disabled="@buscandoAnon">
                @(buscandoAnon ? "Buscando…" : "Buscar piezas")
            </button>
        </p>
    </div>

    @if (resultadoAnon is not null)
    {
        @if (resultadoAnon.Count == 0)
        {
            <div class="tarjeta">
                <p class="vacio">No hay piezas del catálogo para ese vehículo.</p>
            </div>
        }
        else
        {
            <p class="conteo">@resultadoAnon.Count piezas que le van</p>
            <div class="piezas">
                @foreach (var pieza in resultadoAnon)
                {
                    <article class="pieza">
                        <TarjetaRepuesto Repuesto="pieza" Vehiculo="vehiculoAnonDto" />
                    </article>
                }
            </div>
        }
    }
}
else
{
    <section class="entrada">
        <h1>Qué le pasa a tu auto</h1>
        <p>Elegí uno de tus vehículos y contá el problema. Te mostramos las piezas que le van.</p>
    </section>

    @if (vehiculos.Count == 0)
    {
        <div class="buscador">
            <p>Todavía no cargaste ningún auto.</p>
            <p><a class="boton" href="/clientes">Agregar un vehículo</a></p>
        </div>
    }
    else
    {
        <div class="buscador">
            <div>
                <label for="vehiculo">Tu vehículo</label>
                <select id="vehiculo" @bind="vehiculoSeleccionado">
                    @foreach (var vehiculo in vehiculos)
                    {
                        <option value="@vehiculo.Id">@Etiqueta(vehiculo)</option>
                    }
                </select>
            </div>

            <div style="margin-top:0.85rem">
                <label for="texto">Qué le pasa</label>
                <textarea id="texto" rows="3" @bind="texto"
                          placeholder="Cuando freno vibra el volante y se escucha un chillido"></textarea>
            </div>

            <p style="margin:1rem 0 0">
                <button @onclick="BuscarAsync" disabled="@buscando">
                    @(buscando ? "Buscando…" : "Buscar piezas")
                </button>
            </p>

            @if (errores.Count > 0)
            {
                <div class="aviso error" style="margin-top:1rem">
                    @foreach (var error in errores)
                    {
                        <div>@error</div>
                    }
                </div>
            }
        </div>

        @if (resultado is not null)
        {
            <div class="resultado-meta">
                <h2>@resultado.Busqueda.Vehiculo</h2>
                <p>@resultado.Busqueda.TextoLibre</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(resultado.Busqueda.MotivoFalla))
            {
                <div class="aviso error">@resultado.Busqueda.MotivoFalla</div>
            }
            else if (resultado.Piezas.Count == 0)
            {
                <div class="tarjeta">
                    <p class="vacio">No hay piezas del catálogo para ese vehículo.</p>
                </div>
            }
            else
            {
                <p class="conteo">@resultado.Piezas.Count piezas que le van</p>
                <div class="piezas">
                    @foreach (var pieza in resultado.Piezas)
                    {
                        <article class="pieza">
                            <TarjetaRepuesto Repuesto="pieza" Vehiculo="resultado.Busqueda.Vehiculo" />
                        </article>
                    }
                </div>
            }
        }
    }

    @if (recientes.Count > 0)
    {
        <h2>Tus consultas</h2>
        <ul class="recientes">
            @foreach (var busqueda in recientes)
            {
                <li>
                    <strong>@busqueda.Vehiculo</strong>
                    <span>@busqueda.TextoLibre</span>
                    @if (!string.IsNullOrWhiteSpace(busqueda.MotivoFalla))
                    {
                        <em>@busqueda.MotivoFalla</em>
                    }
                    else
                    {
                        <em>@busqueda.CodigosObjetivo.Count piezas</em>
                    }
                </li>
            }
        </ul>
    }
}

@code {
    private IReadOnlyList<BusquedaDto> recientes = [];
    private ResultadoBusquedaDto? resultado;

    // búsqueda anónima
    private string marcaAnon = "";
    private string modeloAnon = "";
    private int anioAnon = DateTime.Now.Year;
    private string motorAnon = "";
    private string textoAnon = "";
    private bool buscandoAnon;
    private List<string> erroresAnon = [];
    private IReadOnlyList<RepuestoDto>? resultadoAnon;
    private VehiculoDto? vehiculoAnonDto;

    // búsqueda con sesión
    private string vehiculoSeleccionado = "";
    private string texto = "";
    private bool buscando;
    private List<string> errores = [];

    private IReadOnlyList<VehiculoClienteDto> vehiculos =>
        Sesion.Cliente?.Vehiculos ?? [];

    protected override void OnInitialized() => Sesion.Cambio += AlCambiarSesion;

    protected override async Task OnInitializedAsync()
    {
        if (Sesion.Cliente is null)
            return;

        vehiculoSeleccionado = vehiculos.Count > 0 ? vehiculos[0].Id.ToString() : "";
        recientes = await Fachada.ListarBusquedasDelClienteAsync(Sesion.Cliente.Id);
    }

    private void AlCambiarSesion() => _ = InvokeAsync(async () =>
    {
        resultado = null;
        errores = [];
        resultadoAnon = null;
        vehiculoAnonDto = null;
        erroresAnon = [];

        if (Sesion.Cliente is null)
        {
            recientes = [];
            vehiculoSeleccionado = "";
        }
        else
        {
            vehiculoSeleccionado = vehiculos.Count > 0 ? vehiculos[0].Id.ToString() : "";
            recientes = await Fachada.ListarBusquedasDelClienteAsync(Sesion.Cliente.Id);
        }

        StateHasChanged();
    });

    public void Dispose() => Sesion.Cambio -= AlCambiarSesion;

    private async Task BuscarAnonAsync()
    {
        buscandoAnon = true;
        erroresAnon = [];
        resultadoAnon = null;

        try
        {
            if (string.IsNullOrWhiteSpace(marcaAnon) || string.IsNullOrWhiteSpace(modeloAnon))
            {
                erroresAnon = ["Ingresá la marca y el modelo."];
                return;
            }

            vehiculoAnonDto = new VehiculoDto
            {
                Marca = marcaAnon.Trim(),
                Modelo = modeloAnon.Trim(),
                Anio = anioAnon,
                Motor = string.IsNullOrWhiteSpace(motorAnon) ? null : motorAnon.Trim()
            };

            var respuesta = await Fachada.BuscarRepuestosAsync(vehiculoAnonDto, sistema: null);
            if (respuesta.EsFallido)
            {
                erroresAnon = [.. respuesta.Errores];
                return;
            }

            resultadoAnon = [.. respuesta.Valor];
        }
        finally
        {
            buscandoAnon = false;
        }
    }

    private async Task BuscarAsync()
    {
        if (Sesion.Cliente is null)
            return;

        buscando = true;
        errores = [];

        try
        {
            var vehiculo = vehiculos.FirstOrDefault(v => v.Id.ToString() == vehiculoSeleccionado);
            if (vehiculo is null)
            {
                errores = ["Elegí uno de tus vehículos."];
                return;
            }

            var respuesta = await Fachada.BuscarAsync(new CrearBusquedaDto
            {
                ClienteId = Sesion.Cliente.Id,
                Vehiculo = vehiculo.Datos,
                TextoLibre = texto
            });

            if (respuesta.EsFallido)
            {
                resultado = null;
                errores = [.. respuesta.Errores];
                return;
            }

            resultado = respuesta.Valor;
            texto = "";
            recientes = await Fachada.ListarBusquedasDelClienteAsync(Sesion.Cliente.Id);
        }
        finally
        {
            buscando = false;
        }
    }

    private static string Etiqueta(VehiculoClienteDto vehiculo) =>
        vehiculo.Alias == vehiculo.Datos.ToString()
            ? vehiculo.Alias
            : $"{vehiculo.Alias} — {vehiculo.Datos}";
}
