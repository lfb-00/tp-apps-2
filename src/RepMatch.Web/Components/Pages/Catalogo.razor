@page "/catalogo"
@implements IDisposable
@using RepMatch.Aplicacion.Fachada
@using RepMatch.Common.Resultados
@inject FachadaAplicacion Fachada
@inject SesionActual Sesion

<PageTitle>Catálogo — RepMatch</PageTitle>

<section class="entrada">
    <h1>Catálogo de repuestos</h1>
    <p>Buscá piezas por vehículo o explorá el catálogo completo.</p>
</section>

@if (Sesion.Cliente?.Vehiculos.Count > 0)
{
    <div style="margin-bottom:1rem">
        <p style="font-size:0.82rem; font-weight:600; color:var(--color-text-muted); margin:0 0 0.4rem">Tu garage</p>
        <div class="chips">
            @foreach (var vehiculo in Sesion.Cliente.Vehiculos)
            {
                <button type="button" class="chip @(vehiculoSeleccionadoId == vehiculo.Id ? "seleccionado" : "")"
                        @onclick="() => SeleccionarVehiculo(vehiculo)">
                    @vehiculo.Alias
                </button>
            }
        </div>
    </div>
}

<div class="tarjeta">
    <SelectorVehiculo @key="selectorVersion" @bind-Valor="vehiculoSeleccionado" Prefijo="catalogo" Deshabilitado="@buscando" />
    <div class="campos">
        <div>
            <label for="sistema">Sistema</label>
            <select id="sistema" @bind="sistema">
                <option value="">Todos</option>
                <option value="Frenos">Frenos</option>
                <option value="Motor">Motor</option>
                <option value="Suspension">Suspensión</option>
                <option value="Electrico">Eléctrico</option>
                <option value="Refrigeracion">Refrigeración</option>
                <option value="Transmision">Transmisión</option>
                <option value="Direccion">Dirección</option>
            </select>
        </div>
    </div>

    <p style="margin-top:1rem; display:flex; gap:0.5rem; flex-wrap:wrap">
        <button @onclick="BuscarAsync" disabled="@buscando">
            @(buscando ? "Buscando…" : "Buscar compatibles")
        </button>
        <button class="secundario" @onclick="ListarTodoAsync" disabled="@buscando">
            Ver catálogo completo
        </button>
    </p>
</div>

@if (error is not null)
{
    <div class="alerta alerta-error" role="alert">@error</div>
}

@if (repuestos is not null)
{
    @if (repuestos.Count == 0)
    {
        <div class="tarjeta">
            <p class="vacio">
                @if (vehiculoConsultado is not null)
                {
                    <span>No encontramos piezas para @vehiculoConsultado. Probá con otro vehículo o revisá los datos ingresados.</span>
                }
                else
                {
                    <span>El catálogo está vacío.</span>
                }
            </p>
        </div>
    }
    else
    {
        <p class="conteo">@repuestos.Count @(repuestos.Count == 1 ? "pieza" : "piezas") en el catálogo</p>
        <div class="piezas">
            @foreach (var repuesto in repuestos)
            {
                <article class="pieza">
                    <TarjetaRepuesto Repuesto="repuesto" Vehiculo="VehiculoActual" />
                </article>
            }
        </div>
    }
}

@code {
    private VehiculoDto? vehiculoSeleccionado;
    private string sistema = "";

    private bool buscando;
    private string? error;
    private IReadOnlyList<RepuestoDto>? repuestos;
    private VehiculoDto? vehiculoConsultado;
    private Guid? vehiculoSeleccionadoId;
    private int selectorVersion;

    private VehiculoDto? VehiculoActual => vehiculoConsultado;

    protected override void OnInitialized() => Sesion.Cambio += AlCambiarSesion;

    private void AlCambiarSesion() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Sesion.Cambio -= AlCambiarSesion;

    private void SeleccionarVehiculo(VehiculoClienteDto vehiculo)
    {
        if (vehiculoSeleccionadoId == vehiculo.Id)
        {
            vehiculoSeleccionadoId = null;
            vehiculoSeleccionado = null;
        }
        else
        {
            vehiculoSeleccionadoId = vehiculo.Id;
            vehiculoSeleccionado = vehiculo.Datos;
        }
    }

    private async Task BuscarAsync()
    {
        if (vehiculoSeleccionado is null)
        {
            error = "Elegí marca, modelo, año y motor del vehículo.";
            return;
        }

        vehiculoConsultado = vehiculoSeleccionado;

        await EjecutarAsync(ct => Fachada.BuscarRepuestosAsync(
            vehiculoSeleccionado, string.IsNullOrWhiteSpace(sistema) ? null : sistema, ct));
    }

    private Task ListarTodoAsync()
    {
        vehiculoConsultado = null;
        vehiculoSeleccionado = null;
        vehiculoSeleccionadoId = null;
        selectorVersion++;
        return EjecutarAsync(Fachada.ListarRepuestosAsync);
    }

    private async Task EjecutarAsync(
        Func<CancellationToken, Task<ResultadoOperacion<IReadOnlyList<RepuestoDto>>>> operacion)
    {
        buscando = true;
        error = null;

        try
        {
            var resultado = await operacion(CancellationToken.None);
            if (resultado.EsFallido)
            {
                repuestos = null;
                error = resultado.Error;
                return;
            }

            repuestos = resultado.Valor;
        }
        finally
        {
            buscando = false;
        }
    }
}
