@page "/catalogo"
@using RepMatch.Aplicacion.Fachada
@using RepMatch.Common.Resultados
@inject FachadaAplicacion Fachada

<PageTitle>Catálogo - RepMatch</PageTitle>

<h1>Catálogo de repuestos</h1>
<p class="subtitulo">Piezas compatibles con el vehículo que indiques.</p>

<div class="tarjeta">
    <div class="campos">
        <div>
            <label for="marca">Marca</label>
            <input id="marca" @bind="marca" />
        </div>
        <div>
            <label for="modelo">Modelo</label>
            <input id="modelo" @bind="modelo" />
        </div>
        <div>
            <label for="anio">Año</label>
            <input id="anio" type="number" @bind="anio" />
        </div>
        <div>
            <label for="motor">Motor (opcional)</label>
            <input id="motor" @bind="motor" />
        </div>
        <div>
            <label for="sistema">Sistema</label>
            <select id="sistema" @bind="sistema">
                <option value="">Todos</option>
                <option value="Frenos">Frenos</option>
                <option value="Motor">Motor</option>
                <option value="Suspension">Suspensión</option>
                <option value="Electrico">Eléctrico</option>
                <option value="Refrigeracion">Refrigeración</option>
                <option value="Transmision">Transmisión</option>
                <option value="Direccion">Dirección</option>
            </select>
        </div>
    </div>

    <p style="margin-top:1rem">
        <button @onclick="BuscarAsync" disabled="@buscando">
            @(buscando ? "Buscando..." : "Buscar compatibles")
        </button>
        <button class="secundario" @onclick="ListarTodoAsync" disabled="@buscando">
            Ver catálogo completo
        </button>
    </p>
</div>

@if (error is not null)
{
    <div class="aviso error">@error</div>
}

@if (repuestos is not null)
{
    @if (repuestos.Count == 0)
    {
        <div class="tarjeta">
            <p class="vacio">
                No hay repuestos para ese vehículo. Probá con Volkswagen Gol 2015,
                Peugeot 208 2019 o Toyota Corolla 2018.
            </p>
        </div>
    }
    else
    {
        <div class="piezas">
            @foreach (var repuesto in repuestos)
            {
                <article class="pieza">
                    <TarjetaRepuesto Repuesto="repuesto" Vehiculo="VehiculoActual" />
                </article>
            }
        </div>
    }
}

@code {
    private string marca = "Volkswagen";
    private string modelo = "Gol";
    private int anio = 2015;
    private string motor = "1.6";
    private string sistema = "";

    private bool buscando;
    private string? error;
    private IReadOnlyList<RepuestoDto>? repuestos;
    private VehiculoDto? vehiculoConsultado;

    private VehiculoDto? VehiculoActual => vehiculoConsultado;

    private async Task BuscarAsync()
    {
        var vehiculo = new VehiculoDto
        {
            Marca = marca,
            Modelo = modelo,
            Anio = anio,
            Motor = string.IsNullOrWhiteSpace(motor) ? null : motor
        };
        vehiculoConsultado = vehiculo;

        await EjecutarAsync(ct => Fachada.BuscarRepuestosAsync(
            vehiculo, string.IsNullOrWhiteSpace(sistema) ? null : sistema, ct));
    }

    private Task ListarTodoAsync()
    {
        vehiculoConsultado = null;
        return EjecutarAsync(Fachada.ListarRepuestosAsync);
    }

    private async Task EjecutarAsync(
        Func<CancellationToken, Task<ResultadoOperacion<IReadOnlyList<RepuestoDto>>>> operacion)
    {
        buscando = true;
        error = null;

        try
        {
            var resultado = await operacion(CancellationToken.None);
            if (resultado.EsFallido)
            {
                repuestos = null;
                error = resultado.Error;
                return;
            }

            repuestos = resultado.Valor;
        }
        finally
        {
            buscando = false;
        }
    }
}
