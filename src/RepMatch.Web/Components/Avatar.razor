@* Foto de perfil, o un círculo con las iniciales si no hay foto. *@
<span class="avatar" style="width:@(Tamano)px; height:@(Tamano)px; font-size:@(Math.Round(Tamano * 0.4))px" aria-hidden="true">
    @if (!string.IsNullOrEmpty(FotoUrl))
    {
        <img src="@FotoUrl" alt="" />
    }
    else
    {
        @Iniciales
    }
</span>

@code {
    [Parameter, EditorRequired] public string Nombre { get; set; } = "";
    [Parameter] public string? FotoUrl { get; set; }
    [Parameter] public int Tamano { get; set; } = 28;

    private string Iniciales =>
        string.Concat(Nombre
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Take(2)
            .Select(palabra => char.ToUpperInvariant(palabra[0])));
}
