<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
        // Antes del primer pintado, para que el tema oscuro no parpadee en blanco.
        (function () {
            var tema = null;
            try { tema = localStorage.getItem("repmatch-tema"); } catch (e) { }
            var oscuro = tema ? tema === "oscuro" : window.matchMedia("(prefers-color-scheme: dark)").matches;
            document.documentElement.setAttribute("data-theme", oscuro ? "dark" : "light");
        })();
    </script>
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["RepMatch.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="logo-icon.svg" />
    <title>RepMatch</title>
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>

<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
