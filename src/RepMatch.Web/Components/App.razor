<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
        // Antes del primer pintado, para que el tema oscuro no parpadee en blanco.
        (function () {
            var tema = null;
            try { tema = localStorage.getItem("repmatch-tema"); } catch (e) { }
            var oscuro = tema ? tema === "oscuro" : window.matchMedia("(prefers-color-scheme: dark)").matches;
            document.documentElement.setAttribute("data-theme", oscuro ? "dark" : "light");
        })();
    </script>
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["RepMatch.Web.styles.css"]" />
    @* Leaflet para el mapa de casas de repuestos cercanas (CasasCercanas). Version fija con hash:
       si el CDN sirviera otro archivo, el navegador no lo ejecuta. *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous" />
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="anonymous"></script>
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="logo-icon.svg" />
    <title>RepMatch</title>
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>

<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
