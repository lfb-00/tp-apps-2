@inherits LayoutComponentBase
@implements IDisposable
@inject SesionActual Sesion
@inject NavigationManager Navegacion

<div class="app">
    <header class="barra">
        <a class="marca" href="/">
            <span class="logo">RM</span>
            <span>
                <strong>RepMatch</strong>
                <small>Comparador de repuestos</small>
            </span>
        </a>

        <nav>
            <NavLink href="/" Match="NavLinkMatch.All">Buscar</NavLink>
            <NavLink href="/catalogo">Catálogo</NavLink>
            @if (Sesion.Cliente is not null)
            {
                <NavLink href="/clientes">Mi garage</NavLink>
            }
        </nav>

        @if (Sesion.Cliente is not null)
        {
            <div class="quien">
                <span>@Sesion.Cliente.Nombre</span>
                <button class="secundario" @onclick="SalirAsync">Salir</button>
            </div>
        }
    </header>

    <main>
        @if (!sesionLista)
        {
            <p class="vacio">Cargando…</p>
        }
        else
        {
            @Body
        }
    </main>

    <footer>
        RepMatch
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">&#128473;</span>
</div>

@code {
    private bool sesionLista;

    protected override void OnInitialized() => Sesion.Cambio += AlCambiarSesion;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || sesionLista)
            return;

        await Sesion.RestaurarAsync();
        sesionLista = true;
        StateHasChanged();
    }

    private void AlCambiarSesion() => _ = InvokeAsync(StateHasChanged);

    private async Task SalirAsync()
    {
        await Sesion.SalirAsync();
        Navegacion.NavigateTo("/");
    }

    public void Dispose() => Sesion.Cambio -= AlCambiarSesion;
}
