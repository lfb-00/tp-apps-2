@inherits LayoutComponentBase
@implements IDisposable
@inject SesionActual Sesion
@inject NavigationManager Navegacion

<div class="app">
    <header class="barra">
        <a class="marca" href="/">
            <img src="logo-icon.svg" class="marca-icon" alt="" aria-hidden="true" />
            <span class="marca-texto">
                <strong><span class="marca-rep">Rep</span><span class="marca-match">Match</span></strong>
                <small>Comparador de repuestos</small>
            </span>
        </a>

        <nav>
            <NavLink href="/" Match="NavLinkMatch.All">Buscar</NavLink>
            <NavLink href="/catalogo">Catálogo</NavLink>
            @if (Sesion.Cliente is not null)
            {
                <NavLink href="/clientes">Mi garage</NavLink>
            }
        </nav>

        @if (Sesion.Cliente is not null)
        {
            <div class="quien">
                <button class="user-trigger @(dropdownAbierto ? "abierto" : "")" @onclick="ToggleDropdown">
                    @Sesion.Cliente.Nombre
                    <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path d="M5 8l5 5 5-5H5z"/>
                    </svg>
                </button>
                @if (dropdownAbierto)
                {
                    <div class="user-dropdown">
                        <a href="/clientes" @onclick="CerrarDropdown">Mi garage</a>
                        <hr />
                        <button class="salir" @onclick="SalirAsync">Cerrar sesión</button>
                    </div>
                }
            </div>
        }
        else if (!EsLoginPage)
        {
            <div class="quien">
                <a class="btn-ingresar" href="/login">Ingresar</a>
            </div>
        }

        <button class="hamburguesa" aria-label="Abrir menú" @onclick="ToggleNavMobile">
            <span></span><span></span><span></span>
        </button>
    </header>

    <nav class="nav-mobile @(navMobileAbierta ? "abierto" : "")" aria-hidden="@(!navMobileAbierta)">
        <NavLink href="/" Match="NavLinkMatch.All">Buscar</NavLink>
        <NavLink href="/catalogo">Catálogo</NavLink>
        @if (Sesion.Cliente is not null)
        {
            <NavLink href="/clientes">Mi garage</NavLink>
            <hr class="divider" />
            <button class="salir" @onclick="SalirAsync">Cerrar sesión</button>
        }
        else if (!EsLoginPage)
        {
            <hr class="divider" />
            <a href="/login">Ingresar</a>
        }
    </nav>

    <main>
        @if (!sesionLista)
        {
            <p class="vacio">Cargando…</p>
        }
        else
        {
            @Body
        }
    </main>

    <footer>RepMatch</footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">&#128473;</span>
</div>

@code {
    private bool sesionLista;
    private bool dropdownAbierto;
    private bool navMobileAbierta;

    private bool EsLoginPage => Navegacion.Uri.Contains("/login", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Sesion.Cambio += AlCambiarSesion;
        Navegacion.LocationChanged += AlCambiarRuta;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || sesionLista)
            return;

        await Sesion.RestaurarAsync();
        sesionLista = true;
        StateHasChanged();
    }

    private void AlCambiarSesion() => _ = InvokeAsync(StateHasChanged);

    private void AlCambiarRuta(object? sender, LocationChangedEventArgs e)
    {
        navMobileAbierta = false;
        dropdownAbierto = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleDropdown() => dropdownAbierto = !dropdownAbierto;
    private void CerrarDropdown() => dropdownAbierto = false;
    private void ToggleNavMobile() => navMobileAbierta = !navMobileAbierta;

    private async Task SalirAsync()
    {
        dropdownAbierto = false;
        navMobileAbierta = false;
        await Sesion.SalirAsync();
        Navegacion.NavigateTo("/");
    }

    public void Dispose()
    {
        Sesion.Cambio -= AlCambiarSesion;
        Navegacion.LocationChanged -= AlCambiarRuta;
    }
}
