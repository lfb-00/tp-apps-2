{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "Persistencia": {
    "Proveedor": "InMemory"
  },
  "ConnectionStrings": {
    "RepMatch": ""
  },
  "Catalogo": {
    "Modo": "Local",
    "UrlBaseRemota": "http://localhost:5081",
    "TimeoutSegundos": 30
  }
}
