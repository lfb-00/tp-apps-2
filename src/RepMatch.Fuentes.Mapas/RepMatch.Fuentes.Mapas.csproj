<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Polly" Version="8.7.0" />
    <ProjectReference Include="..\RepMatch.Common\RepMatch.Common.csproj" />
    <ProjectReference Include="..\RepMatch.Contracts\RepMatch.Contracts.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Copia de las casas de repuestos de Argentina (OpenStreetMap, ODbL) para cuando la base esta
       vacia y Overpass no responde: un primer arranque sin internet igual muestra casas. -->
  <ItemGroup>
    <EmbeddedResource Include="Datos\casas-argentina.json" LogicalName="RepMatch.Fuentes.Mapas.casas-argentina.json" />
  </ItemGroup>

  <!-- IHttpClientFactory e IDistributedCache, igual que Fuentes.Vtex y Fuentes.Ebay. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
