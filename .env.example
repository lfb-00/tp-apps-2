# Puertos del host. Copia este archivo como .env y cambia solo los que te choquen
# con algo que ya tengas corriendo:
#
#   cp .env.example .env
#
# Los contenedores siempre se hablan entre si por la red interna, asi que cambiar
# estos valores no afecta el funcionamiento: solo cambia por donde los ves vos.

# Aplicacion web (Blazor Server)
PUERTO_WEB=8080

# Host REST del componente de catalogo
PUERTO_CATALOGO=8081

# Host SOAP del componente de catalogo (WSDL en /ConsultaCompatibilidad.svc?wsdl)
PUERTO_CATALOGO_SOAP=8082

# Host REST del componente de IA
PUERTO_IA=8083

# PostgreSQL. Cambialo si ya tenes un Postgres local en el 5432.
PUERTO_POSTGRES=5432

# Web en modo Local (perfil "local", opcional)
PUERTO_WEB_LOCAL=8090

# LLM del componente de IA (opcional). Sin clave responde el clasificador local.
# Groq (por defecto):  https://console.groq.com/keys
# Gemini:              IA_LLM_URLBASE=https://generativelanguage.googleapis.com/v1beta/openai/
#                      IA_LLM_MODELO=gemini-2.5-flash
# Nunca pongas la clave en un archivo que se commitea: este .env esta en .gitignore.
IA_LLM_APIKEY=
#IA_LLM_URLBASE=https://api.groq.com/openai/v1/
#IA_LLM_MODELO=llama-3.3-70b-versatile

# Tiendas donde buscar precios (API publica de VTEX, sin credenciales). Por defecto las reales;
# scripts/e2e.sh las apunta al simulador. CACHE_MINUTOS=0 desactiva la cache de respuestas.
#OFERTAS_URL_EASY=https://www.easy.com.ar
#OFERTAS_URL_FRAVEGA=https://www.fravega.com
#OFERTAS_CACHE_MINUTOS=10

# Cola de mensajes (RabbitMQ). La UI de administracion queda en http://localhost:15672 con este
# usuario. Es un entorno de laboratorio: en cualquier otro, cambiar la contrasena.
PUERTO_RABBITMQ=5672
PUERTO_RABBITMQ_UI=15672
#RABBITMQ_USUARIO=repmatch
#RABBITMQ_CONTRASENA=repmatch

# Worker que consume la cola (/salud y GET /api/comisiones)
PUERTO_WORKER=8085
